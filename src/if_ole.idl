// if_ole.idl - IDL source for the ViAI OLE Automation interface
//
// Processed by the IDL compiler (MIDL) to generate the type library
// (viai.tlb).
//
// Command line:
//   MIDL /proxy nul /iid iid_ole.c /h if_ole.h /tlb viai.tlb if_ole.idl

[
	object,
	uuid(BE8F954A-D4A0-4B15-832E-0EDFD51E73BB),  // IID_IViAI
	helpstring("IViAI"),
	pointer_default(unique),
	dual,
	oleautomation
]
interface IViAI : IDispatch
{
	import "oaidl.idl";
	HRESULT SendKeys([in]BSTR keys);
	HRESULT Eval([in]BSTR expr, [out, retval]BSTR* result);
	HRESULT SetForeground(void);
	HRESULT GetHwnd([out, retval]UINT_PTR* result);
};

// Component and type library definitions
[
	uuid(78496282-B4E6-4DC3-9E18-0A3A198430F5),		// LIBID_ViAI
	helpstring("ViAI OLE Interface 1.1 Type Library"),
	version(1.1)
]
library ViAI
{
	importlib("stdole32.tlb");

	// Component
	[
		uuid(0FC5FC34-0F74-4E54-9D57-E4E8621839B8),  // CLSID_ViAI
		helpstring("ViAI OLE Interface")
	]
	coclass ViAI
	{
		[default] interface IViAI;
	};
};
